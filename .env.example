# 이 파일을 복사해서 .env 로 만들어 사용하세요: cp .env.example .env
# 백엔드 REST 주소 (/api 포함)
VITE_API_BASE_URL=http://localhost:3000/api
# 백엔드 WebSocket 주소 (namespace /rooms 는 코드에서 붙임)
VITE_WS_URL=http://localhost:3000
# (선택) 참가 QR·링크가 가리킬 공개 웹 주소. 없으면 현재 오리진을 쓴다.
# 앱인토스 미니앱 번들은 *.tossmini.com 오리진에서 실행되는데 그 주소는 토스앱 밖에서 안 열린다.
# 그래서 미니앱용 빌드에서는 이 값을 반드시 채워야 참가자가 QR 로 입장할 수 있다.
VITE_PUBLIC_WEB_URL=
# (선택) 앱인토스 배너 광고 그룹 ID. 콘솔에서 발급받아 채운다.
# 비워 두면 개발용 테스트 광고 ID 로 돈다 — 실제 ID 로 개발/테스트하면 무효 트래픽으로 제재받는다.
VITE_ADS_BANNER_GROUP_ID=
# (선택) 광고 킬 스위치. false 로 두면 코드 수정 없이 광고만 내린다. 기본은 켜짐.
VITE_ADS_ENABLED=
# (선택) Google Meet 애드온용 Google Cloud 프로젝트 번호.
# Meet 애드온으로 배포할 때만 필요 — 없으면 Meet 초기화를 건너뛴다(다른 채널엔 영향 없음).
VITE_MEET_CLOUD_PROJECT_NUMBER=
